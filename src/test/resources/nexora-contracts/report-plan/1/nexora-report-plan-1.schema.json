{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.ai/contracts/report-plan/1",
  "title": "nexora-report-plan/1",
  "description": "Plan de un reporte completo: un plan lógico por dataset, ejecutados con consistencia de instantánea.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "nexora-report-plan/1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dataSourceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "profile": {
      "enum": [
        "basic-a",
        "basic-b"
      ]
    },
    "specFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "datasetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "planId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "planFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "datasetId",
          "planId",
          "planFingerprint"
        ]
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "SINGLE_READ_ONLY_TRANSACTION"
        },
        "isolation": {
          "const": "REPEATABLE_READ"
        },
        "readOnly": {
          "const": true
        },
        "schemaVerification": {
          "const": "IN_TRANSACTION"
        },
        "onPlanFailure": {
          "const": "REFUSE_RUN"
        }
      },
      "required": [
        "mode",
        "isolation",
        "readOnly",
        "schemaVerification",
        "onPlanFailure"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "$comment": "C-4 (1 nov 2026): /1 no admite alcance por fila. La lista existe solo para mantener la forma del documento y debe estar vacía.",
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "rules"
      ]
    },
    "compositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/composition"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPlans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxRowsPerPlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxTotalRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "statementTimeoutMs": {
          "type": "integer",
          "minimum": 100
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 100
        }
      },
      "required": [
        "maxPlans",
        "maxRowsPerPlan",
        "maxTotalRows",
        "statementTimeoutMs",
        "maxDurationMs"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "tenantId",
    "dataSourceId",
    "profile",
    "specFingerprint",
    "plans",
    "consistency",
    "scope",
    "compositions",
    "budget",
    "fingerprint"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "basic-a",
              "basic-b"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "compositions": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "op": {
          "enum": [
            "PREVIOUS_PERIOD",
            "DELTA",
            "PCT_CHANGE",
            "SHARE",
            "FILL_ZERO",
            "TOP_N_REST",
            "CALC"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          }
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "op",
        "inputs",
        "params"
      ]
    }
  }
}
